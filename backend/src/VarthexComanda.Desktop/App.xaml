<Application x:Class="VarthexComanda.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VarthexComanda.Desktop">
    <Application.Resources>
        <!-- Tamanhos para uso por toque (campos e botoes >= 46 px). Valores locais nas telas prevalecem. -->
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Resources>
                <!-- O botao do calendario interno do DatePicker nao deve herdar o tamanho de toque dos botoes. -->
                <Style TargetType="Button" />
            </Style.Resources>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="16,8" />
        </Style>
    </Application.Resources>
</Application>
